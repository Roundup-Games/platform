APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=roundup_games
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

HORIZON_NAME="${APP_NAME}"
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Mailto entry of the List-Unsubscribe header stamped on every category mail
# (TaggedMailChannel); the https entry is the per-recipient signed one-click
# URL. Defaults to the company support address (config/company.php).
# MAIL_UNSUBSCRIBE_MAILTO=support@roundup.games
RESEND_API_KEY=
# Svix signing secret from the Resend webhook dashboard (whsec_...). Drives
# delivery/bounce/complaint ingestion + list hygiene.
RESEND_WEBHOOK_SECRET=

# ── Non-prod Mailpit pattern (D281 — docs/notification-verification.md §6) ──
# All non-prod mail lands in the homelab Mailpit (an OUTSIDE-stack Unraid CA
# container, not a docker-compose service): SMTP 192.168.178.31:1025, web UI
# + REST API on :8025. Pure env configuration — no transport code change —
# so non-prod consumes ZERO Resend quota (D283; Resend stays prod-only).
# Already wired on the main checkout's .env; uncomment in worktrees/other
# non-prod slots. Health check: curl http://192.168.178.31:8025/api/v1/messages
# Multi-project mailbox convention: senders add "X-Tags: roundup-games-dev"
# (PLURAL header — a singular X-Tag is silently ignored) so Mailpit filters
# this project's mail via tag:roundup-games-dev.
# MAIL_MAILER=smtp
# MAIL_HOST=192.168.178.31
# MAIL_PORT=1025
# Auto-stamped on every outgoing mail (notifications + Mailables) by the
# TagProjectMail listener when set; leave unset in prod.
# MAIL_PROJECT_TAG=roundup-games-dev

# Mail markdown theme (M081/D279): 'roundup' is the branded amber/cream theme
# applied to every markdown-rendered mail. Override only to diff against the
# framework default ('default') locally.
# MAIL_MARKDOWN_THEME=roundup

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Calendar managed sync (M083, D300) — default-deny: with these
# defaults nobody may connect (unverified calendar.events sensitive scope).
# The calendar-link callback is APP_URL/settings/calendar/google/callback
# and must ALSO be an authorized redirect URI on the Google OAuth client.
# Enable + allowlist only test accounts until Google's scope verification
# passes (owner-attested flip to verified afterwards).
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_VERIFICATION_MODE=test_user
GOOGLE_CALENDAR_RECONCILE_EVERY_MINUTES=15
GOOGLE_CALENDAR_TEST_USER_ALLOWLIST=""

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Discord Bot (M057 event-bridge — REST push, no gateway)
DISCORD_BOT_TOKEN=
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Discord Interactions endpoint (M057/S03). The Ed25519 public key +
# application id from the Discord Developer Portal (General Information).
# The public key verifies X-Signature-Ed25519 on every interaction request.
# Leaving these unset makes the endpoint 401 every request (fail closed).
DISCORD_BOT_PUBLIC_KEY=
DISCORD_BOT_APPLICATION_ID=
# ── Dev-application pattern (D282 — docs/notification-verification.md) ──
# Non-prod verification runs a SECOND Discord application (roundup-dev)
# alongside the production bot, so test-guild interaction button-clicks
# land on the non-prod backend instead of performing real joins in prod.
# Local + homelab non-prod point ALL THREE keys above (DISCORD_BOT_TOKEN /
# DISCORD_BOT_PUBLIC_KEY / DISCORD_BOT_APPLICATION_ID) at the DEV
# application's portal values; production keeps the production values.
# NEVER mix: token, public key, and application id must all come from the
# SAME application — Discord routes component interactions to the owning
# application, so a mismatched keyset fails closed or, worse, routes
# test clicks to production.
# Master switch for the DiscordPublisher chokepoint (M057/T05). Off by
# default so the sync-queue test suite and pre-M057 deploys are unaffected;
# enable when the bot is installed and channels are live.
DISCORD_PUBLISHING_ENABLED=false
# Whether the bot opens a per-session thread on each posted card (default
# on). A guild that hasn't granted the bot thread permissions simply gets no
# thread — the card still posts. No pings.
DISCORD_SESSION_THREADS_ENABLED=true
# Discord Bot Install (M057/T06). The bot defaults to the login OAuth
# client for single-application setups; set these when the bot is a separate
# Discord application (D118). The redirect URI is the post-install callback.
DISCORD_BOT_CLIENT_ID=
DISCORD_BOT_CLIENT_SECRET=
DISCORD_BOT_REDIRECT_URI="${APP_URL}/discord/install/callback"
# Optional: override the onboarding message posted to the system channel
# on a fresh install. Empty uses the default roundup onboarding text.
DISCORD_INSTALL_ONBOARDING_MESSAGE=

# Paddle Billing
PADDLE_SELLER_ID=
PADDLE_AUTH_CODE=
PADDLE_API_KEY=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=true

# Paddle Price IDs
PADDLE_ANNUAL_PRICE_ID=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_GM_MONTHLY_PRICE_ID=
PADDLE_GM_ANNUAL_PRICE_ID=

# Cashier
CASHIER_CURRENCY=USD
CASHIER_CURRENCY_LOCALE=en
CASHIER_PATH=paddle

# VAPID (Web Push Notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudflare API (for cache rule sync — php artisan cloudflare:cache-rules)
CF_ZONE_ID=
CF_API_TOKEN=

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ENABLED=true

# Attendance
ATTENDANCE_REPORTING_WINDOW_HOURS=72
ATTENDANCE_AUTO_COMPLETE_OFFSET_HOURS=12

# Escalated Plugin SDK (not used locally)
ESCALATED_PLUGINS_ENABLED=false

# Log-derived alerting (observability) — optional Discord webhook observability:scan pages on critical matches
OBSERVABILITY_DISCORD_WEBHOOK_URL=
# Log-derived alerting (observability) — true to also page that Discord webhook (email pages regardless)
OBSERVABILITY_PAGE_DISCORD=false
# Log-derived alerting (observability) — false disables the alertable_errors tap (tests set this)
OBSERVABILITY_TAP_ENABLED=true
# Log-derived alerting (observability) — comma-separated operator inbox(es) for scan pages,
# the daily digest, and scheduled-command failure mails. MUST be a monitored address in
# production: the MAIL_FROM_ADDRESS fallback is noreply@ there (a black hole).
OBSERVABILITY_OPS_EMAIL=

# Worker heartbeat (observability) — dead-man's-switch ping URL (e.g.
# healthchecks.io) fired by the worker watchdog ONLY while Horizon AND the
# scheduler are healthy. Success-only: a dead/sick worker or box stops pinging,
# so the external check alerts. Leave empty to disable. Create a dedicated check
# first: period 1 minute, grace >= 15 minutes (deploy worker rolls are silent up
# to ~14); do NOT share the backup container's PHARE_CRON_PING_URL check.
WORKER_HEARTBEAT_URL=
