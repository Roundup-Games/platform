#!/command/with-contenv bash
# S6 initialization script — runs once before main processes start
# /etc/cont-init.d/ scripts are executed by S6 Overlay on container start

cd /var/www/html

# Close the init-complete gate first thing. The marker lives in /tmp
# (container-local — storage/ is a volume SHARED between the app and worker
# containers, a marker there would leak one container's state to the other)
# and survives a container restart, so a stale one from the previous boot must
# be cleared before this run starts rewriting caches. The worker healthcheck
# waits for this marker before it boots artisan: Docker runs healthchecks
# outside s6 ordering, so without the gate that probe is the one process that
# can boot Laravel while the init is still rewriting caches.
rm -f /tmp/laravel-init-complete

# Create the database if it doesn't exist (external Postgres)
if [ "${DB_CONNECTION}" = "pgsql" ] && [ -n "${DB_HOST}" ]; then
    echo "Ensuring database '${DB_DATABASE}' exists on ${DB_HOST}:${DB_PORT}..."
    PGPASSWORD="${DB_PASSWORD}" psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USERNAME}" \
        -d postgres -tc "SELECT 1 FROM pg_database WHERE datname = '${DB_DATABASE}'" | grep -q 1 || \
    PGPASSWORD="${DB_PASSWORD}" psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USERNAME}" \
        -d postgres -c "CREATE DATABASE ${DB_DATABASE};"
    echo "Database ready."
fi

# Ensure APP_KEY is set — generate if missing, persist to .env file
# The .env file is needed so artisan commands via `docker exec` can find it
# (docker exec does NOT inherit S6's envdir — only docker-compose env_file vars)
if [ -z "${APP_KEY}" ]; then
    echo "Generating APP_KEY..."
    GENERATED_KEY=$(php artisan key:generate --show)
    export APP_KEY="${GENERATED_KEY}"
else
    GENERATED_KEY="${APP_KEY}"
fi

# Write APP_KEY to .env file so docker exec sessions can use it
touch .env
if grep -q '^APP_KEY=' .env; then
    sed -i "s|^APP_KEY=.*|APP_KEY=${GENERATED_KEY}|" .env
else
    echo "APP_KEY=${GENERATED_KEY}" >> .env
fi

# Run migrations + first-time seeding in exactly ONE container. The worker
# container inherits this init script; running `migrate --force` in both
# containers concurrently races the migrations table on every deploy.
# Set RUN_MIGRATIONS=0 on every non-owner service (see docker-compose.yml).
if [ "${RUN_MIGRATIONS:-1}" = "1" ]; then
    echo "Running migrations..."
    php artisan migrate --force
else
    echo "RUN_MIGRATIONS=0 — skipping migrations (owner service runs them)."
fi

# Cache config for production: it reads the environment, so it must run
# here at container start, not at build time. view:cache also stays here —
# compiled views are written to storage/framework/views (the shared volume)
# and baking them into the image is pointless under the app_storage mount.
# route:cache and event:cache were removed from here: they do not read the
# environment and are baked into the image at build time (see Dockerfile) —
# running them here deleted and rewrote bootstrap/cache/routes-v7.php on
# every start, which is the deploy-window race behind the boot-time
# ErrorException in error tracking.
echo "Caching config and views..."
# Soft dependency preflight (MEM1147): warn — never block boot — when
# Redis or Postgres are not reachable yet, so reboot-window outages are
# visible in container logs instead of only as user-facing 500s.
if ! php artisan tinker --execute='try { DB::select("select 1"); } catch (Throwable \$e) { exit(1); }' >/dev/null 2>&1; then
    echo "preflight: DATABASE unreachable at boot — is postgresql17 up and on the roundup network?"
fi
if ! php artisan tinker --execute='try { Illuminate\Support\Facades\Redis::ping(); } catch (Throwable \$e) { exit(1); }' >/dev/null 2>&1; then
    echo "preflight: REDIS unreachable at boot — is Redis up and on the roundup network?"
fi

php artisan config:cache
php artisan view:cache

# Seed Escalated helpdesk data (departments, tags, SLA policies) — idempotent
# Allow errors to surface in container logs for debugging; || true prevents script failure
if [ "${RUN_MIGRATIONS:-1}" = "1" ]; then
    echo "Seeding Escalated helpdesk data..."
    php artisan db:seed --force --class=EscalatedSetupSeeder || true
fi

# Write deploy timestamp for admin dashboard
date -u +"%Y-%m-%d %H:%M:%S UTC" > /var/www/html/storage/framework/deploy-timestamp

# Open the init-complete gate. Everything that boots artisan during this
# init has finished, so the worker healthcheck may now run its own artisan
# probe safely (see the gate comment at the top of this script).
touch /tmp/laravel-init-complete

echo "Laravel startup complete."
