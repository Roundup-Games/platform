includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    # phpstan-strict-rules staged adoption (census: .gsd/research/phpstan-strict-rules-census-2026-10-30.txt)
    # Stages 0-4 (2026-10-30) armed every zeroed family: 0+1 the zero-baseline
    # set, Stage 2 the truthiness trio, Stage 3 noVariableVariables +
    # checkDynamicProperties, Stage 4 uselessCast. Enable a family in the same
    # change that zeroes it. dynamicCallOnStaticMethod stays off permanently:
    # 99.7% of its findings are larastan's @static-forwarded vendor signatures
    # (Builder chains, session()->flash(), auth()->user()) — arming is not
    # feasible without baselines or vendor stubs.
    strictRules:
        allRules: false
        disallowedLooseComparison: true
        booleansInLoopConditions: true
        requireParentConstructorCall: true
        disallowedBacktick: true
        disallowedImplicitArrayCreation: true
        overwriteVariablesWithLoop: true
        closureUsesThis: true
        matchingInheritedMethodNames: true
        numericOperandsInArithmeticOperators: true
        switchConditionsMatchingType: true
        illegalConstructorMethodCall: true
        strictFunctionCalls: true
        strictArrayFilter: true
        # Stage 2 (2026-10-30): '0'/0/''/false/null conflation families —
        # armed after a full-codebase zeroing sweep (commits B1–B4).
        disallowedEmpty: true
        disallowedShortTernary: true
        booleansInConditions: true
        # Stage 3 (2026-10-30): variable variables/dynamic property-method
        # access banned after the 11-site refactor (match dispatch, raw
        # attribute reads, data_get/data_set for the translatable trait).
        noVariableVariables: true
        # Stage 4 (2026-10-30): same-type casts banned after the 454-site
        # sweep (defensive id-comparison casts, option/config bool casts).
        uselessCast: true
    # Bundled core-param flips that carry open debt stay at framework defaults.
    # Stage 3 (2026-10-30): checkDynamicProperties armed after the 114-finding
    # triage sweep (computed-cache @property docs, getAttribute for
    # query-decorated attributes, phantom User::$timezone removed).
    checkDynamicProperties: true
    paths:
        - app
    level: 9
    stubFiles:
        - stubs/EscalatedTicket.stub
        - stubs/EscalatedTicketSubjectLink.stub
        - stubs/EscalatedDepartment.stub
        - stubs/EscalatedReply.stub
        - stubs/EscalatedTicketStatus.stub
        - stubs/HasTranslations.stub
        - stubs/IlluminateCache.stub
        - stubs/IlluminateCacheLockInterface.stub
        - stubs/SchemaOrg.stub
    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # OAuthController::isEmailVerified keeps a runtime is_array() guard against
        # legacy Socialite payloads typed `array` but null in the wild. Keep the
        # guard; silence the always-narrowed heuristic for this one call site.
        -
            identifier: function.alreadyNarrowedType
            path: app/Http/Controllers/Auth/OAuthController.php
        # ProximityQuery::nearestSessionByCampaign narrows a mixed input
        # collection to ProximityResult<Game> after an instanceof filter;
        # filter() cannot express TValue narrowing, so the @var is intentional.
        -
            identifier: varTag.type
            path: app/Services/ProximityQuery.php
